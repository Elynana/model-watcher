# ---------------------------------------------------------------------------
# Delivery. Set at least one.
# ---------------------------------------------------------------------------
# Simplest path: a channel incoming webhook. Alerts post here unconditionally.
DISCORD_WEBHOOK_URL=

# Full bot: enables slash commands and per-channel /watch subscriptions.
# Create the application at https://discord.com/developers/applications, then
# invite it with the `bot` and `applications.commands` scopes.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Optional. Registers commands to one guild (applies in seconds, not ~1 hour).
DISCORD_GUILD_ID=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# 1 prints proposed alerts to the log without contacting Discord.
SHADOW_MODE=0
# 0 disables the locally rendered PNG card.
IMAGE_CARDS=1
# Parallel source fetches (1-16). Per-domain pacing still applies.
CONCURRENCY=6
# Local development only. GitHub Actions points this at its state worktree.
STATE_DIR=data/state

# ---------------------------------------------------------------------------
# First-party model-list credentials — all optional.
#
# The keyless catalog layer (models.dev, LiteLLM, OpenRouter, fal.ai, Vercel AI
# Gateway, GitHub Models, Ollama, DeepInfra, Novita, Chutes, NanoGPT, Hugging
# Face organizations, official pages, and official feeds) already covers every
# publisher listed below. A key only adds faster, higher-confidence first-party
# detection for that one publisher.
#
# Only read-only model listing is ever requested. Leave a key blank and that
# publisher's public sources still run.
# ---------------------------------------------------------------------------

# Frontier labs
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
