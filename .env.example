# The only required production secret: Discord channel incoming webhook.
DISCORD_WEBHOOK_URL=

# Set to 1 for a 48-hour rollout preview. Messages are printed in Actions logs.
SHADOW_MODE=0

# Set to 0 to disable locally rendered PNG cards.
IMAGE_CARDS=1

# Optional read-only model-list credentials. The public-source watcher works
# without every variable below.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=

# Local development only. GitHub Actions sets this to its state worktree.
STATE_DIR=data/state
