{
  "name": "model-watcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "description": "Free GitHub Actions watcher for cutting-edge generative AI model releases.",
  "scripts": {
    "watch": "tsx src/index.ts",
    "dry": "tsx src/index.ts --dry-run --force",
    "seed": "tsx src/index.ts --seed --force",
    "fixtures": "node --import tsx --test test/fixtures.test.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  }
}
